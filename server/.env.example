# Скопируйте в server/.env и замените ключи. Файл .env не коммитится.
# iOS-приложение ходит с первым ключом, бот-ассистент — со вторым.
DISCIPLINA_IOS_API_KEY=dev-ios-key
DISCIPLINA_BOT_API_KEY=dev-bot-key
DISCIPLINA_DB_PATH=./data/disciplina.db
# Слушать только localhost и открыть наружу через `tailscale serve`.
DISCIPLINA_HOST=127.0.0.1
DISCIPLINA_PORT=8741
